# Copy this file to .env and edit it for your machine. Never commit .env.

# Flask secret for signing JWT tokens. Generate your own:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-to-a-long-random-string

# Database. Default is a SQLite file inside the backend folder (no setup).
# MySQL (team decision) example:
#   DATABASE_URL=mysql+pymysql://user:password@localhost:3306/injection_quality
DATABASE_URL=

# Login token length in minutes (the front end also logs out after 2 hours)
TOKEN_MINUTES=120

# Allowed front end address (comma separated for several)
CORS_ORIGIN=http://localhost:5173

# Limits
MAX_CONTENT_MB=50
MAX_BATCH_ROWS=5000
MAX_TRAIN_ROWS=60000

# Server port for `python app.py`
PORT=5000

# Set to 1 for Flask debug output (never in production)
FLASK_DEBUG=0
